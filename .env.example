# 프론트 자체 테스트: 개발 모드에서 MSW 목업이 자동으로 /api 요청을 처리합니다.
VITE_USE_MOCK_API=true
# 목업 테스트 계정으로 자동 로그인합니다. 수동 로그인을 테스트하려면 false로 설정하세요.
VITE_AUTO_LOGIN_MOCK=true
# 테스트 계정: session.test@kiiwee.app / kiiwee1234
# 백엔드 배포 후 아래 줄의 주석을 해제하고 실제 API 주소를 지정하세요.
# VITE_API_BASE_URL=https://api.example.com
# 목업을 끄고 로컬 백엔드(http://localhost:8080)에 연결하려면 false로 설정하세요.
# VITE_USE_MOCK_API=false
# 실시간 세션 WebSocket 주소 (백엔드 배포 후 환경에 맞게 설정하세요.)
# VITE_WS_URL=ws://localhost:8080/ws
